generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum CourseType {
  BARBER_PRO
  UNAS_PRO
  ONLINE
  SEMINARIO
}

enum MaterialVisibility {
  STUDENTS
  TEACHERS
  BOTH
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  EXPORT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

// User & Auth
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?

  // Audits & Resources
  auditLogs          AuditLog[]
  createdMaterials   Material[]
  gradesGiven        Grade[]       @relation("TeacherGrades")
  issuedCertificates Certificate[] @relation("AdminCertificates")
}

model StudentProfile {
  id               String  @id @default(uuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dni              String?
  phone            String?
  address          String?
  emergencyContact String?
  photoUrl         String?
  
  scheduleUrl        String?
  paymentScheduleUrl String?
  resourceLinks      Json?

  enrollments Enrollment[]
}

model TeacherProfile {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty String?
  bio       String?

  cohorts CohortTeacher[]
}

// Academic Structure
model Campus {
  id      String   @id @default(uuid())
  name    String   @unique // Jesus Maria, Surco, Callao
  address String?
  cohorts Cohort[]
}

model Course {
  id          String     @id @default(uuid())
  title       String     @unique
  type        CourseType
  description String?
  imageUrl    String?

  cohorts Cohort[]
}

model Cohort {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id])
  campusId String
  campus   Campus @relation(fields: [campusId], references: [id])

  name      String // e.g. "Grupo A - Mañana"
  startDate DateTime
  endDate   DateTime?
  schedule  String? // "Lunes y Miércoles 9-12"
  capacity  Int       @default(20)

  teachers    CohortTeacher[]
  enrollments Enrollment[]
  materials   Material[]
}

// Many-to-Many via explicit table for Teachers <-> Cohorts
model CohortTeacher {
  id        String         @id @default(uuid())
  cohortId  String
  cohort    Cohort         @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  isPrimary Boolean        @default(false)

  @@unique([cohortId, teacherId])
}

model Enrollment {
  id         String           @id @default(uuid())
  studentId  String
  student    StudentProfile   @relation(fields: [studentId], references: [id])
  cohortId   String
  cohort     Cohort           @relation(fields: [cohortId], references: [id])
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())

  attendance   Attendance[]
  grades       Grade[]
  certificates Certificate[]
}

// Operations
model Attendance {
  id           String     @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  date         DateTime
  isPresent    Boolean
  notes        String?

  @@unique([enrollmentId, date])
}

model Grade {
  id           String     @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  moduleName   String
  score        Float // Range: 0-20
  feedback     String?

  gradedByTeacherId String
  gradedBy          User   @relation("TeacherGrades", fields: [gradedByTeacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, moduleName])
}

model Material {
  id         String             @id @default(uuid())
  cohortId   String
  cohort     Cohort             @relation(fields: [cohortId], references: [id])
  title      String
  fileUrl    String
  type       String // PDF, LINK, VIDEO
  visibility MaterialVisibility @default(BOTH)
  createdAt  DateTime           @default(now())

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
}

model Certificate {
  id                String            @id @default(uuid())
  enrollmentId      String
  enrollment        Enrollment        @relation(fields: [enrollmentId], references: [id])
  issuedAt          DateTime          @default(now())
  certificateUrl    String?
  certificateNumber String            @unique
  status            CertificateStatus @default(ISSUED)

  issuedByAdminId String
  issuedBy        User   @relation("AdminCertificates", fields: [issuedByAdminId], references: [id])
}

model News {
  id          String   @id @default(uuid())
  title       String
  body        String
  publishedAt DateTime @default(now())
  imageUrl    String?
}

model JobBoard {
  id          String   @id @default(uuid())
  title       String
  company     String
  description String
  contactInfo String
  postedAt    DateTime @default(now())
  isActive    Boolean  @default(true)
}

model AuditLog {
  id          String      @id @default(uuid())
  actorUserId String
  action      AuditAction
  entity      String // "User", "Grade", etc.
  entityId    String
  meta        Json? // Previous values, details
  createdAt   DateTime    @default(now())
  User        User?       @relation(fields: [userId], references: [id])
  userId      String?
}
